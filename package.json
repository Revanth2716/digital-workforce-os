{
  "name": "digital-workforce-os",
  "version": "0.1.0",
  "description": "Digital Workforce OS — governed multi-agent AI workflow system (Milestones 1-2: core foundation + AI agent layer)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "demo": "tsx src/cli.ts",
    "demo:ai": "tsx src/cli.ts --ai",
    "demo:safety": "tsx src/cli.ts --safety",
    "dev": "tsx src/cli.ts",
    "api": "tsx src/api/main.ts",
    "smoke:api": "tsx scripts/api-smoke-test.ts",
    "dashboard": "pnpm --filter @digital-workforce-os/dashboard dev",
    "dashboard:build": "pnpm --filter @digital-workforce-os/dashboard build",
    "dashboard:test": "pnpm --filter @digital-workforce-os/dashboard test",
    "dashboard:typecheck": "pnpm --filter @digital-workforce-os/dashboard typecheck",
    "start": "node dist/cli.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:persistence": "node scripts/verify-persistence.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm demo",
    "demo:final": "tsx src/orchestrator/final-demo.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
